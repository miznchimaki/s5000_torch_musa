#include "torch_musa/csrc/aten/musa/MUSAMacros.muh"
#pragma once

#include <c10/util/Exception.h>
#include <mutlass/mutlass.h>

namespace at::musa::detail {

template <typename Kernel>
struct enable_2x_kernel_for_sm89 : Kernel {
  template <typename... Args>
  MUTLASS_DEVICE static void invoke(Args&&... args) {
#if defined __MUSA_ARCH__ && __MUSA_ARCH__ == 890
    Kernel::invoke(std::forward<Args>(args)...);
#endif
  }
};

template <typename Kernel>
struct enable_3x_kernel_for_sm9x : Kernel {
  template <typename... Args>
  MUTLASS_DEVICE void operator()(Args&&... args) {
#if defined __MUSA_ARCH__ && __MUSA_ARCH__ >= 900 && __MUSA_ARCH__ < 1000
    Kernel::operator()(std::forward<Args>(args)...);
#endif
  }
};

template <typename Kernel>
struct enable_3x_kernel_for_sm10 : Kernel {
  template <typename... Args>
  MUTLASS_DEVICE void operator()(Args&&... args) {
#if defined __MUSA_ARCH__ && __MUSA_ARCH__ >= 1000 && __MUSA_ARCH__ < 1200
    Kernel::operator()(std::forward<Args>(args)...);
#endif
  }
};

template <typename Kernel>
struct enable_3x_kernel_for_sm10_or_later : Kernel {
  template <typename... Args>
  MUTLASS_DEVICE void operator()(Args&&... args) {
#if defined __MUSA_ARCH__ && __MUSA_ARCH__ >= 1000
    Kernel::operator()(std::forward<Args>(args)...);
#endif
  }
};

}  // namespace at::musa::detail
